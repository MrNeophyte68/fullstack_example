{
  "name": "client",
  "version": "1.0.0",
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json --poll 1000",
    "build": "ng build",
    "deploy": "ng build",
    "format": "prettier --config ../.prettierrc.yaml --ignore-path ../.prettierignore --write \"src/**/*\"",
    "test": "ng test",
    "coverage": "ng test --watch=false --coverage",
    "lint": "eslint --config eslint.config.mjs \"src/**/*.{ts,html}\"",
    "lint:report": "eslint --config eslint.config.mjs \"src/**/*.{ts,html}\" --format gitlab",
    "lint:fix": "eslint --config eslint.config.mjs \"src/**/*.{ts,html}\" --fix",
    "architecture": "node ../scripts/check-architecture.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/router": "22.1.1",
    "rxjs": "7.8.2",
    "socket.io-client": "4.8.3",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@eslint/js": "10.0.1",
    "@types/jasmine": "6.0.0",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-formatter-gitlab": "^7.2.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "6.3.0",
    "jsdom": "^29.1.1",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^4.1.11"
  }
}
