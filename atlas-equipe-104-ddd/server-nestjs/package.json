{
  "name": "server-nestjs",
  "description": "Serveur du projet de base pour le cours de LOG2995",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "prebuild": "rimraf out",
    "build": "rimraf out && nest build && node scripts/resolve-imports.cjs",
    "format": "prettier --config ../.prettierrc.yaml --write \"app/**/*\"",
    "start": "ts-node -r tsconfig-paths/register app/index.ts",
    "start:debug": "node --inspect -r ts-node/register -r tsconfig-paths/register app/index.ts",
    "lint": "eslint --config eslint.config.mjs \"./app/**/*.ts\"",
    "lint:report": "eslint --config eslint.config.mjs \"./app/**/*.ts\" --format gitlab",
    "lint:fix": "eslint --config eslint.config.mjs \"./app/**/*.ts\" --fix",
    "test": "jest",
    "coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "start:prod": "node out/server-nestjs/app/index.js",
    "start:dev": "node --watch -r ts-node/register -r tsconfig-paths/register app/index.ts",
    "architecture": "node ../scripts/check-architecture.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/platform-socket.io": "11.1.29",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.1.29",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "9.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^24.13.3",
    "@types/sinon": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.8.1",
    "eslint-formatter-gitlab": "^7.2.0",
    "jest": "30.4.2",
    "mongodb-memory-server": "11.2.0",
    "prettier": "^3.9.6",
    "rimraf": "6.1.3",
    "sinon": "^22.1.0",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "app/**/*.(t|j)s",
      "!app/app.module.ts",
      "!app/index.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app(.*)$": "<rootDir>/app/$1",
      "^@common(.*)$": "<rootDir>/../common/$1"
    }
  }
}
